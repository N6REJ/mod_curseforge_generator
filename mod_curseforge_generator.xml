<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_curseforge_GENERATOR</name>
	<author>N6REJ</author>
	<creationDate>2026 October 22</creationDate>
	<copyright>Copyright (C) 2026 N6REJ</copyright>
	<license>GNU General Public License version 3 (GPL-3.0-only)</license>
	<authorEmail>n6rej@protonmail.com</authorEmail>
	<authorUrl>https://github.com/N6REJ</authorUrl>
	<version>2026.10.22.1</version>
	<description>MOD_curseforge_GENERATOR_DESC</description>
	<dependencies>
		<php version="8.1" />
		<joomla version="5.0" />
	</dependencies>


	<files>
		<filename module="mod_curseforge_generator">mod_curseforge_generator.php</filename>
		<filename>helper.php</filename>
		<folder>tmpl</folder>
		<folder>media</folder>
		<folder>language</folder>
	</files>

	<media destination="mod_curseforge_generator" folder="media">
		<folder>js</folder>
		<folder>css</folder>
	</media>

	<languages>
		<language tag="en-GB">language/en-GB/mod_curseforge_generator.ini</language>
		<language tag="en-GB">language/en-GB/mod_curseforge_generator.sys.ini</language>
	</languages>
	<updateservers>
		<server type="extension" priority="1" name="curseforge Generator Updates">https://raw.githubusercontent.com/N6REJ/mod_curseforge_generator/main/updates.xml</server>
	</updateservers>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="default_owner"
					type="text"
					label="MOD_curseforge_GENERATOR_OWNER_LABEL"
					description="MOD_curseforge_GENERATOR_OWNER_DESC"
					default="N6REJ"
					size="30"
				/>
				<field
					name="default_repo"
					type="text"
					label="MOD_curseforge_GENERATOR_REPO_LABEL"
					description="MOD_curseforge_GENERATOR_REPO_DESC"
					default="mod_bears_pricing_tables"
					size="30"
				/>
				<field
					name="default_branch"
					type="text"
					label="MOD_curseforge_GENERATOR_BRANCH_LABEL"
					description="MOD_curseforge_GENERATOR_BRANCH_DESC"
					default="main"
					size="15"
				/>
				<field
					name="default_jsonpath"
					type="text"
					label="MOD_curseforge_GENERATOR_JSONPATH_LABEL"
					description="MOD_curseforge_GENERATOR_JSONPATH_DESC"
					default="stats/downloads.json"
					size="30"
				/>
				<field
					name="default_style"
					type="list"
					label="MOD_curseforge_GENERATOR_STYLE_LABEL"
					description="MOD_curseforge_GENERATOR_STYLE_DESC"
					default="flat-square"
				>
					<option value="flat">MOD_curseforge_GENERATOR_STYLE_FLAT</option>
					<option value="flat-square">MOD_curseforge_GENERATOR_STYLE_FLAT_SQUARE</option>
					<option value="plastic">MOD_curseforge_GENERATOR_STYLE_PLASTIC</option>
					<option value="for-the-badge">MOD_curseforge_GENERATOR_STYLE_FOR_THE_BADGE</option>
					<option value="social">MOD_curseforge_GENERATOR_STYLE_SOCIAL</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="moduleclass_sfx"
					type="text"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
				/>
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
