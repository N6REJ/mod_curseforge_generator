{
    "$schema": "https://joomla.org",
    "name": "mod_curseforge_generator",
    "version": "2026.10.21",
    "description": "CurseForge Downloads Badge Generator Module Web Assets",
    "license": "MIT",
    "assets": [
        {
            "name": "mod_curseforge_generator.style",
            "type": "style",
            "version": "2026.10.21",
            "description": "CurseForge Generator module CSS styles",
            "uri": "mod_curseforge_generator/css/style.css",
            "dependencies": [
                "bootstrap.css"
            ]
        },
        {
            "name": "mod_curseforge_generator.script",
            "type": "script",
            "version": "2026.10.21",
            "description": "CurseForge Generator module JavaScript",
            "uri": "mod_curseforge_generator/js/curseforge-generator.js",
            "dependencies": [
                "core",
                "bootstrap.dropdown"
            ],
            "attributes": {
                "defer": true
            }
        },
        {
            "name": "mod_curseforge_generator",
            "type": "preset",
            "version": "2026.10.21",
            "description": "CurseForge Generator module preset - loads all CSS and JS assets",
            "dependencies": [
                "mod_curseforge_generator.style",
                "mod_curseforge_generator.script"
            ]
        }
    ]
}
